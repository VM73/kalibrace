{
  "name": "kalibrace",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/calc.test.mjs tests/sql.test.mjs && python -m unittest discover -s tests -p \"test_*.py\" && playwright test",
    "test:py": "python -m unittest discover -s tests -p \"test_*.py\" -v",
    "test:calc": "node --test tests/calc.test.mjs",
    "test:sql": "node --test tests/sql.test.mjs",
    "test:e2e": "playwright test",
    "serve": "node tests/serve.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.65.1",
    "@supabase/supabase-js": "^2.118.0"
  }
}
